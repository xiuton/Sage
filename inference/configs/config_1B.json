  "use_cache": true,
  "vocab_size": 30522,
  "tie_word_embeddings": false,
  "rope_theta": 10000.0,
  "rope_scaling": {
    "type": "linear",
    "factor": 2.0
  },
  "moe": {
    "num_experts": 4,
    "num_experts_per_tok": 2
  },
  "mla": {
    "lora_rank_q": 128,
    "lora_rank_kv": 64
  }
}